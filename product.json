{
  "name": "Email bulk deliverability check",
  "brand": "EmailCheckPro",
  "repository": "emailcheckpro/email-bulk-deliverability-api",
  "description": "Upload a whole file of addresses, find out which ones can receive mail, and download the result when it finishes.",
  "official_site": "https://emailcheckpro.com",
  "landing_page": "https://emailcheckpro.com/products/email_batch",
  "canonical_docs": "https://emailcheckpro.com/api-docs",
  "base_url": "https://emailcheckpro.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "email_batch",
  "identifier_kind": "email",
  "requires_country": false,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 500000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "identifier",
      "example": "alex.kim@example.com",
      "description": "Submitted identifier, used to join the result to the input. Phone identifiers include their country code."
    },
    {
      "name": "activated",
      "example": "true",
      "description": "The determined positive/negative signal for this product; interpret it in the product context."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://emailcheckpro.com/pricing",
  "maintainer": "EmailCheckPro",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
